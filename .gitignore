# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# uv / venv
.venv/

# Database (runtime state — never commit)
*.db
*.db-wal
*.db-shm
fund.db*

# Env / secrets
.env
*.local.yaml
# Agent API keys written by scripts/setup_demo_firm.py — shown once, never
# recoverable, and enough to act as that agent.
*.local.json

# Claude Code personal/local settings (shared settings.json may be committed)
.claude/settings.local.json

# Cassettes and run records (R-4a, B-000i): a run is a proof object, not source
*.cassette.json
.openrouter-mint.lock
experiments/*/runs/

# OS
.DS_Store

# Recorded runs kept as evidence of an idea (keys redacted, world key never inside)
!evidence/**/*.cassette.json
