{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Task",
      "Agent",
      "Bash",
      "TodoWrite",
      "Edit(.claude/skills/**)",
      "Write(.claude/skills/**)"
    ],
    "deny": [
      "Edit(bible/00_CONSTITUTION.md)",
      "Edit(bible/01_GENESIS.md)",
      "Edit(governance/**)",
      "Edit(loop/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git branch -D*)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Edit(~/.firm/**)",
      "Bash(git rm -r*)",
      "Bash(git rm -rf*)",
      "Edit(.claude/commands/**)",
      "Edit(.claude/agents/**)",
      "Write(bible/00_CONSTITUTION.md)",
      "Write(bible/01_GENESIS.md)",
      "Write(governance/**)",
      "Write(loop/**)",
      "Write(.claude/settings.json)",
      "Write(.claude/hooks/**)",
      "Write(.claude/commands/**)",
      "Write(.claude/agents/**)",
      "Write(~/.firm/**)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ],
    "additionalDirectories": [
      "~/.openclaw",
      "~/firm-openclaw-backups"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_gate.py\"",
            "timeout": 3600
          }
        ]
      }
    ]
  }
}
